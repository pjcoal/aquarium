# Solana token the tank reacts to. Leave the mint empty to run on a simulated market.
NEXT_PUBLIC_TOKEN_MINT=
NEXT_PUBLIC_TOKEN_TICKER=TOKEN

# Optional: LLM-backed thought endpoint (see lib/thoughtEngine.ts)
NEXT_PUBLIC_THOUGHT_ENDPOINT=

# Claude writes the fish conversations (server-side only; never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
AQUARIUM_TALK_MODEL=claude-opus-5-5
AQUARIUM_TALK_HOURLY_LIMIT=120
